packages:
    ./aoc-haskell
    ./aoc-common-hs
    ./2015/Haskell
    ./2019/Haskell
    ./2020/Haskell
    ./2021/Haskell
    ./2022/Haskell
    ./2023/Haskell
    ./2024/Haskell
    ./2025/Haskell

optimization: 2

package *
    ghc-options: -Wall -Wno-name-shadowing -Werror=missing-fields -rtsopts "-with-rtsopts=-A64m"
